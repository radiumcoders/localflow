class Target:
    """The window a dictation started in, and the project open there. kind is
    "editor" (Cursor, VS Code), "terminal" or "other" (a browser, Slack...)."""

    def __init__(self, app="", title="", pid=None, tags=()):
        a = (app or "").lower()
        self.app, self.pid, self.cwd, self.project, self.files = app, pid, None, None, []
        self.kind = ("editor" if a in EDITORS else
                     "terminal" if TERMINALS.search(a) or any(t.startswith("terminal") for t in tags) else "other")
        if self.kind == "editor":
            self.project = editor_project(EDITORS[a], title)
        elif self.kind == "terminal" and pid:
            self.cwd = terminal_cwd(pid, title)
            self.project = project_root(self.cwd) if self.cwd else None
        if not self.project:  # no project here (or none we can see): the one you last had open
            self.project = recent_project()
        if self.project:
            self.files = project_files(self.project)

    def __str__(self):
        return f"{self.kind} {self.app!r}, project {self.project}, {len(self.files)} files"

    def ref(self, path):
        """How this app takes a reference to `path` (relative to the project):
        ("text", "@path") pasted, or ("file", absolute path) pasted as an
        attachment. Editors and terminals get text: nothing is typed, so the
        focus never moves."""
        full = self.project / path
        if self.kind in ("editor", "terminal") or path.endswith("/"):
            try:
                shown = full.relative_to(self.cwd or self.project).as_posix()
            except ValueError:
                shown = full.as_posix()
            return "text", "@" + shown + ("/" if path.endswith("/") and not shown.endswith("/") else "")
        return "file", str(full)


def focused_window():
    """(app, title, pid, tags) of the window you're typing in; app is the window
    class (Linux), program file (Windows) or bundle id (macOS)."""
    if SYSTEM == "Windows":
        return win_focused()
    if SYSTEM == "Darwin":
        return Mac.focused()
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2)
        w = json.loads(r.stdout or "{}") or {}
        return w.get("class", ""), w.get("title", ""), w.get("pid"), w.get("tags", [])
    if os.environ.get("DISPLAY") and shutil.which("xdotool"):
        get = lambda what: subprocess.run(["xdotool", "getactivewindow", what], capture_output=True,
                                          text=True, timeout=2).stdout.strip()
        pid = get("getwindowpid")
        return get("getwindowclassname"), get("getwindowname"), int(pid) if pid.isdigit() else None, []
    return "", "", None, []  # other Wayland desktops don't say


def win_focused():
    from ctypes import wintypes
    u, k = ctypes.WinDLL("user32"), ctypes.WinDLL("kernel32")
    u.GetForegroundWindow.restype = ctypes.c_void_p
    u.GetWindowTextLengthW.argtypes = [ctypes.c_void_p]
    u.GetWindowTextW.argtypes = [ctypes.c_void_p, ctypes.c_wchar_p, ctypes.c_int]
    u.GetWindowThreadProcessId.argtypes = [ctypes.c_void_p, ctypes.POINTER(wintypes.DWORD)]
    k.OpenProcess.restype = ctypes.c_void_p
    k.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
    k.QueryFullProcessImageNameW.argtypes = [ctypes.c_void_p, wintypes.DWORD, ctypes.c_wchar_p,
                                             ctypes.POINTER(wintypes.DWORD)]
    k.CloseHandle.argtypes = [ctypes.c_void_p]
    hwnd = u.GetForegroundWindow()
    if not hwnd:
        return "", "", None, []
    title = ctypes.create_unicode_buffer(u.GetWindowTextLengthW(hwnd) + 1)
    u.GetWindowTextW(hwnd, title, len(title))
    pid = wintypes.DWORD()
    u.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
    exe = ""
    h = k.OpenProcess(0x1000, False, pid.value)  # PROCESS_QUERY_LIMITED_INFORMATION
    if h:
        buf, size = ctypes.create_unicode_buffer(1024), wintypes.DWORD(1024)
        if k.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(size)):
            exe = Path(buf.value).name
        k.CloseHandle(h)
    return exe, title.value, pid.value, []


def editor_folders(name):
    """Folders a VS Code-family editor has open or had open, most recent first,
    from its state files."""
    if SYSTEM == "Windows":
        base = Path(os.environ.get("APPDATA", HOME)) / name
    elif SYSTEM == "Darwin":
        base = HOME / "Library/Application Support" / name
    else:
        base = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / name
    state, uris = base / "User/globalStorage", []
    try:
        d = json.loads((state / "storage.json").read_text(encoding="utf-8"))
        windows = d.get("windowsState") or {}
        uris += [w.get("folder") for w in [windows.get("lastActiveWindow") or {}] + windows.get("openedWindows", [])]
        uris += [f.get("folderUri") for f in (d.get("backupWorkspaces") or {}).get("folders", [])]
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    try:
        import sqlite3
        db = sqlite3.connect(f"{(state / 'state.vscdb').as_uri()}?mode=ro", uri=True, timeout=0.5)
        try:
            row = db.execute("SELECT value FROM ItemTable WHERE key = 'history.recentlyOpenedPathsList'").fetchone()
        finally:
            db.close()
        if row:
            uris += [e.get("folderUri") for e in json.loads(row[0]).get("entries", [])]
    except Exception:
        pass
    folders = []
    for uri in uris:
        if uri and uri.startswith("file://"):
            path = Path(urllib.request.url2pathname(urllib.parse.unquote(urllib.parse.urlparse(uri).path)))
            if path not in folders and path.is_dir():
                folders.append(path)
    return folders


def editor_project(name, title):
    """The project in the editor window: its title is "file - folder - Cursor"."""
    folders = editor_folders(name)
    parts = [p.strip(" ●") for p in re.split(r" [-—–] ", title or "")]
    return next((f for f in folders if f.name in parts), folders[0] if folders else None)


def recent_project():
    """The project in the editor you used last, for apps that have none."""
    found = []
    for name in sorted(set(EDITORS.values())):
        folders = editor_folders(name)
        if folders:
            base = {"Windows": Path(os.environ.get("APPDATA", HOME)), "Darwin": HOME / "Library/Application Support"
                    }.get(SYSTEM, Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config"))
            try:
                used = (base / name / "User/globalStorage/storage.json").stat().st_mtime
            except OSError:
                used = 0
            found.append((used, folders[0]))
    return max(found, key=lambda f: f[0])[1] if found else None


def processes():
    """{pid: (parent pid, program name)} for every process."""
    procs = {}
    if SYSTEM == "Linux":
        for d in os.listdir("/proc"):
            if d.isdigit():
                try:
                    with open(f"/proc/{d}/stat") as f:
                        stat = f.read()
                    end = stat.rindex(")")
                    procs[int(d)] = (int(stat[end + 2:].split()[1]), stat[stat.index("(") + 1:end])
                except (OSError, ValueError, IndexError):
                    pass
    else:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            try:
                pid, ppid, comm = line.split(None, 2)
                procs[int(pid)] = (int(ppid), os.path.basename(comm.strip()))
            except ValueError:
                pass
    return procs


def cwds(pids):
    """{pid: working directory} for those of `pids` we can see."""
    found = {}
    if SYSTEM == "Linux":
        for pid in pids:
            try:
                found[pid] = Path(os.readlink(f"/proc/{pid}/cwd"))
            except OSError:
                pass
    elif pids and shutil.which("lsof"):
        out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, pids))],
                             capture_output=True, text=True, timeout=3).stdout
        pid = None
        for line in out.splitlines():
            if line.startswith("p"):
                pid = int(line[1:])
            elif line.startswith("n") and pid:
                found[pid] = Path(line[1:])
    return found


def terminal_cwd(pid, title):
    """The directory you're working in, in a terminal window: one named in its
    title (many shells put it there), else that of a coding agent running in
    it, else that of the newest program in it."""
    for m in re.finditer(r"~?/[^\s:'\"|()]*", title or ""):
        path = Path(os.path.expanduser(m.group(0)))
        if len(m.group(0)) > 2 and path != HOME and path.is_dir():
            return path
    if SYSTEM == "Windows":
        return None  # another process's directory isn't readable there
    procs, children = processes(), {}
    for p, (parent, _) in procs.items():
        children.setdefault(parent, []).append(p)
    under, todo = [], list(children.get(pid, []))
    while todo:
        p = todo.pop()
        under.append(p)
        todo += children.get(p, [])
    under.sort(key=lambda p: (procs[p][1] in AGENTS, p), reverse=True)  # agents, then newest
    found = cwds(under[:30])
    return next((found[p] for p in under[:30] if p in found), None)


def project_root(cwd):
    """The git repository around `cwd`, or `cwd` itself."""
    for d in (cwd, *cwd.parents):
        if (d / ".git").exists():
            return d
    return None if cwd == HOME or cwd.parent == cwd else cwd


def git_exe():
    git = shutil.which("git")
    if SYSTEM == "Darwin" and git == "/usr/bin/git" and not Path("/Library/Developer/CommandLineTools").exists() \
            and not Path("/Applications/Xcode.app").exists():
        return None  # the stub that offers to install the developer tools
    return git


def project_files(root, limit=20000):
    """The project's files and folders ("src/", with a slash), relative to root.
    Skips what git ignores."""
    files, git = None, git_exe()
    if git:
        try:
            r = subprocess.run([git, "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
                               capture_output=True, timeout=3, creationflags=NO_WINDOW)
            if r.returncode == 0:
                files = [f for f in r.stdout.decode("utf-8", "replace").split("\0") if f][:limit]
        except (OSError, subprocess.TimeoutExpired):
            pass
    if files is None:  # not a git repository
        files = []
        for d, dirs, names in os.walk(root):
            dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not x.startswith(".")]
            rel = Path(d).relative_to(root)
            files += [(rel / n).as_posix() for n in names]
            if len(files) >= limit:
                break
    folders = {"/".join(f.split("/")[:i]) + "/" for f in files for i in range(1, f.count("/") + 1)}
    return files + sorted(folders)


# Words that point at a file; without one, no file list goes to the cleanup.
FILE_TALK = re.compile(r"\b(?:files?|folders?|director(?:y|ies)|scripts?|modules?|components?|configs?|"
                       r"read ?me|dot [a-z0-9]{1,5}|attach\w*|refer\w*|mention\w*|tag)\b", re.I)
# Words around a file's name ("the settings file"), not part of it.
NAMING = {"the", "a", "an", "file", "files", "folder", "folders", "directory", "script", "module", "component",
          "config", "to", "at", "and", "in", "of", "on", "my", "our", "this", "that", "look", "refer", "check"}


def file_candidates(text, files, limit=12):
    """The project paths the dictation most likely names, best first; [] when
    it doesn't sound like it mentions a file."""
    if not files or not FILE_TALK.search(text):
        return []
    compact = lambda t: re.sub(r"[^a-z0-9]", "", t.lower())
    index = {}
    for path in files:
        name = path.rstrip("/").rsplit("/", 1)[-1]
        stem = name if name.startswith(".") else name.split(".")[0]
        for key in {compact(name), compact(stem), compact(path)}:
            if len(key) >= 3:
                index.setdefault(key, set()).add(path)
    words = re.findall(r"[a-z0-9]+", text.lower())
    grams = set()
    for n in range(1, 5):  # "settings", "dictate dot py", "test local flow", "read me"
        for i in range(len(words) - n + 1):
            ws = words[i:i + n]
            if ws[0] not in NAMING and ws[-1] not in NAMING and ws[-1] != "dot":
                gram = "".join(w for w in ws if w != "dot")
                if len(gram) >= 3:
                    grams.add(gram)
    score = {}
    for g in grams:
        for path in index.get(g, ()):
            score[path] = max(score.get(path, 0), 2 * len(g))
    if len(grams) * len(index) <= 400000:  # near misses ("e to e" for e2e, "settings" for setting)
        import difflib
        for g in (g for g in grams if len(g) >= 5):
            for key in difflib.get_close_matches(g, index, n=3, cutoff=0.8):
                ratio = difflib.SequenceMatcher(None, g, key).ratio()
                for path in index[key]:
                    score[path] = max(score.get(path, 0), ratio * len(g))
    best = sorted(score, key=lambda p: (-score[p], p.count("/"), len(p)))
    return best[:limit]


def deliver(text, target, offered):
    """Paste the cleaned text, with each @path the cleanup wrote for one of the
    `offered` files put in the way the app takes it (see Target.ref)."""
    parts = []
    for kind, value in (localflow().file_refs(text, offered) if offered and target else [("text", text)]):
        if kind == "file":
            kind, value = target.ref(value)
        if kind == "text" and parts and parts[-1][0] == "text":
            parts[-1] = ("text", parts[-1][1] + value)
        else:
            parts.append((kind, value))
    if len(parts) == 1 and parts[0][0] == "text":
        return Paste.text(parts[0][1])
    return Paste.parts(parts)


