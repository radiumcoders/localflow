class HotkeyController:
    """What the hotkey does: hold to talk (stop on release), or tap to start and
    tap again to stop; Escape cancels. `new_dictation()` makes a Dictation,
    `finish(d)` finishes one in the background, `message(text)` shows a problem."""
    TAP = 0.35  # a press shorter than this is a tap

    def __init__(self, new_dictation, finish, message):
        self.new_dictation, self.finish, self.message = new_dictation, finish, message
        self.d, self.pressed, self.toggle, self.working = None, 0.0, False, False

    def recording(self):
        return self.d is not None

    def on(self, event, now=None):
        now = time.monotonic() if now is None else now
        d = self.d
        if event == "press":
            if d is None and not self.working:
                try:
                    self.d = self.new_dictation()
                    self.d.start()
                except Exception as e:
                    self.d = None
                    log.exception("couldn't start recording")
                    self.message(str(e)[:40])
                self.pressed, self.toggle = now, False
            elif d is not None and self.toggle:
                self._finish(d)
        elif event == "release" and d is not None:
            if now - self.pressed < self.TAP and not self.toggle:
                self.toggle = True  # a tap: keep recording until the next tap
            elif not self.toggle:
                self._finish(d)
        elif event == "escape" and d is not None:
            self.d = None
            d.cancel()

    def _finish(self, d):
        self.d = None
        self.working = True

        def run():
            try:
                self.finish(d)
            finally:
                self.working = False
        threading.Thread(target=run, daemon=True).start()


