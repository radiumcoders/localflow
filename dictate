class HotkeyController:
    """What the hotkey does: hold to talk (stop on release), or tap to start and
    tap again to stop; Escape cancels. `new_dictation()` makes a Dictation,
    `finish(d)` finishes one in the background, `message(text)` shows a problem."""
    TAP = 0.35  # a press shorter than this is a tap

    def __init__(self, new_dictation, finish, message, learn=None):
        self.new_dictation, self.finish, self.message, self.learn = new_dictation, finish, message, learn
        self.d, self.pressed, self.toggle, self.working = None, 0.0, False, False

    def recording(self):
        return self.d is not None

    def on(self, event, now=None):
        now = time.monotonic() if now is None else now
        d = self.d
        if event == "press":
            if d is None and not self.working:
                try:
                    self.d = self.new_dictation()
                    self.d.start()
                except Exception as e:
                    self.d = None
                    log.exception("couldn't start recording")
                    self.message(str(e)[:40])
                self.pressed, self.toggle = now, False
            elif d is not None and self.toggle:
                self._finish(d)
        elif event == "release" and d is not None:
            if now - self.pressed < self.TAP and not self.toggle:
                self.toggle = True  # a tap: keep recording until the next tap
            elif not self.toggle:
                self._finish(d)
        elif event == "escape" and d is not None:
            self.d = None
            d.cancel()
        elif event == "learn" and d is None and not self.working and self.learn:
            self.working = True

            def run():
                try:
                    self.message(self.learn())
                except Exception as e:
                    log.exception("learning failed")
                    self.message(str(e)[:40])
                finally:
                    self.working = False
            threading.Thread(target=run, daemon=True).start()

    def _finish(self, d):
        self.d = None
        self.working = True

        def run():
            try:
                self.finish(d)
            finally:
                self.working = False
        threading.Thread(target=run, daemon=True).start()


def cmd_background():
    setup_logging()
    lock = socket.socket()
    try:
        lock.bind(("127.0.0.1", 11437))  # one instance only
    except OSError:
        log.info("already running")
        return
    events, ui = queue.Queue(), queue.Queue()
    root, overlay = make_ui()
    keys = HotkeyController(lambda: Dictation(ui), lambda d: d.finish(),
                            lambda text: ui.put(("message", text, 3000)), learn_correction)
    listener = windows_hotkey if SYSTEM == "Windows" else mac_hotkey

    def listen():
        try:
            listener(events, keys.recording)
        except Exception as e:
            log.error("hotkey: %s", e)
            events.put(("error", str(e)))
    threading.Thread(target=listen, daemon=True).start()

    def tick():
        try:
            while True:
                ev = events.get_nowait()
                if ev == "ready":
                    log.info("ready: hold %s to dictate, %s to learn a correction",
                             *(("Ctrl+Shift+Space", "Ctrl+Alt+Space") if SYSTEM == "Windows"
                               else ("Option+Shift+Space", "Option+Shift+L")))
                elif isinstance(ev, tuple):
                    ui.put(("message", "Allow localflow under Accessibility" if "Accessibility" in ev[1]
                            else "Hotkey unavailable, see dictate.log", 6000))
                else:
                    keys.on(ev)
        except queue.Empty:
            pass
        return True

    run_ui(root, overlay, ui, tick)


# --- Self-test ----------------------------------------------------------------------------

def foreground():
    """Something that identifies the focused window, to check the overlay doesn't take focus."""
    if SYSTEM == "Windows":
        return ctypes.windll.user32.GetForegroundWindow()
    if SYSTEM == "Darwin":
        return Mac.frontmost_pid()
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True)
        try:
            w = json.loads(r.stdout or "{}")
            return f"{w.get('class')} {w.get('address')}" if w else None
        except ValueError:
            return None
    return None


def cmd_selftest(seconds):
    """Exercise each piece that doesn't need a person: prints one line per check."""
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    results = []

    def check(name, fn):
        try:
            detail = fn()
            results.append(True)
            print(f"PASS {name}{': ' + str(detail) if detail else ''}", flush=True)
        except SkipTest as e:
            print(f"SKIP {name}: {e}", flush=True)
        except Exception as e:
            results.append(False)
            print(f"FAIL {name}: {type(e).__name__}: {e}", flush=True)

    def wav_roundtrip():
        pcm = array.array("h", (int(8000 * math.sin(i / 8)) for i in range(RATE))).tobytes()
        path = Path(tempfile.gettempdir()) / "dictate-selftest.wav"
        with wave.open(str(path), "wb") as w:
            w.setnchannels(1), w.setsampwidth(2), w.setframerate(RATE), w.writeframes(pcm)
        with wave.open(str(path)) as w:
            assert (w.getframerate(), w.getnchannels(), w.getnframes()) == (RATE, 1, RATE)
        path.unlink()
        assert level(pcm) > 0.5 and level(bytes(3200)) == 0.0
        return f"loud level {level(pcm):.2f}, silence 0.00"

    def overlay_test():
        import tkinter  # noqa: F401 (fails loudly without Tk)
        before = foreground()
        root, overlay = make_ui()
        if root is None:
            raise RuntimeError("Tk didn't start")
        after_init = foreground()
        ui = queue.Queue()
        steps = [("recording", False)] + [("level", abs(math.sin(i / 3))) for i in range(40)] + \
                [("working", "Transcribing"), ("working", "Cleaning up"), ("message", "Done")]
        t0 = time.monotonic()
        samples = []  # focus while the pill shows

        def tick():
            if steps:
                ui.put(steps.pop(0))
            if overlay.state != "hidden":
                samples.append(foreground())
            return time.monotonic() - t0 < seconds

        run_ui(root, overlay, ui, tick, period=50)
        if before is None:
            return "shown recording / transcribing / message (focus not checkable here)"
        moved = [f for f in samples if f != before]
        where = f"focus {before}, after start {after_init}, this process {os.getpid()}"
        # A moment with no focused window at all (0 on Windows) isn't the pill taking it.
        if samples and samples[-1] != before or after_init not in (before, 0, None):
            raise AssertionError(f"the overlay kept focus: {where}, while shown {sorted(set(samples), key=str)}")
        flicker = f", but it moved for {len(moved)} of {len(samples)} checks" if moved else ""
        return f"shown recording / transcribing / message, focus unchanged{flicker} ({where})"

    def clipboard():
        sample = "localflow ✓ test\nline two"
        if SYSTEM == "Windows":
            old = WinClipboard.get()
            WinClipboard.set(sample.replace("\n", "\r\n"))
            got = WinClipboard.get().replace("\r\n", "\n")
            if old is not None:
                WinClipboard.set(old)
        elif SYSTEM == "Darwin":
            env = dict(os.environ, LC_CTYPE="UTF-8")
            old = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout
            subprocess.run(["pbcopy"], input=sample.encode(), env=env)
            got = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout.decode()
            subprocess.run(["pbcopy"], input=old, env=env)
        else:
            if not shutil.which("wl-copy") or not os.environ.get("WAYLAND_DISPLAY"):
                raise SkipTest("no Wayland clipboard")
            old = subprocess.run(["wl-paste", "--no-newline"], capture_output=True).stdout
            quiet = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}  # wl-copy stays running
            subprocess.run(["wl-copy"], input=sample.encode(), **quiet)
            got = subprocess.run(["wl-paste", "--no-newline"], capture_output=True).stdout.decode()
            subprocess.run(["wl-copy"], input=old, **quiet)
        assert got == sample, repr(got)
        if SYSTEM == "Windows":  # a file, as for an attachment
            WinClipboard.set_files([sys.executable if FROZEN else __file__])
            has_file = bool(ctypes.windll.user32.IsClipboardFormatAvailable(15))  # CF_HDROP
            if old is not None:
                WinClipboard.set(old)
        elif SYSTEM == "Darwin":
            Mac.copy_file(sys.executable if FROZEN else __file__)
            info = subprocess.run(["osascript", "-e", "clipboard info"], capture_output=True, text=True).stdout
            has_file = "furl" in info
            subprocess.run(["pbcopy"], input=old, env=env)
        else:
            return "set and read back unicode + newlines"
        assert has_file, "no file on the clipboard"
        return "set and read back unicode + newlines, and a file"

    def hotkey():
        if SYSTEM == "Linux":
            raise SkipTest("Linux uses compositor key bindings")
        events = queue.Queue()
        listener = windows_hotkey if SYSTEM == "Windows" else mac_hotkey
        errors = []
        threading.Thread(target=lambda: _catch(listener, events, errors), daemon=True).start()
        for _ in range(40):
            if not events.empty() or errors:
                break
            time.sleep(0.05)
        first = None if events.empty() else events.get_nowait()
        if isinstance(first, tuple):  # macOS without Accessibility: it waits for it
            errors.append(first[1])
        if errors:
            if SYSTEM == "Darwin" and "Accessibility" in errors[0]:
                raise SkipTest(errors[0])
            raise RuntimeError(errors[0])
        assert first == "ready", first
        return "keyboard hook installed"

    def microphone():
        chunks = []
        try:
            rec = Recorder(chunks.append)
            rec.start()
        except Exception as e:
            raise SkipTest(f"no microphone ({e})")
        time.sleep(0.6)
        pcm = rec.stop()
        if not pcm:
            raise SkipTest("recorder gave no audio (no microphone?)")
        return f"{len(pcm) / (2 * RATE):.2f}s recorded, level {level(pcm):.2f}"

    def https():
        import ssl
        import urllib.error
        try:
            urllib.request.urlopen("https://api.github.com", timeout=10).read(1)
        except urllib.error.HTTPError:  # an answer at all means the certificate checked out
            pass
        except urllib.error.URLError as e:
            if isinstance(e.reason, ssl.SSLError):
                raise RuntimeError(f"HTTPS certificates can't be verified: {e.reason}") from None
            raise SkipTest(f"offline? ({e.reason})") from None
        return "certificates verified (api.github.com)"

    def handy():
        exe = handy_path()
        if not exe:
            raise SkipTest("Handy not installed")
        return exe

    def cleanup_module():
        lf = localflow()
        return f"localflow loaded ({lf.MODEL or 'no model'} via {lf.API_URL or lf.OLLAMA})"

    def text_box():
        if SYSTEM == "Linux":
            raise SkipTest("Linux learns from what you send (no text box access)")
        box = Mac.focused_text() if SYSTEM == "Darwin" else WinUIA.get().focused_text()
        return f"read {len(box[1])} characters from pid {box[0]}" if box else "no text box focused (read without errors)"

    def target():
        window = focused_window()
        t = Target(*window)
        return f"{t} (title {len(window[1])} chars, pid {window[2]})"

    print(f"dictate self-test on {SYSTEM} {platform.release()}, Python {platform.python_version()}")
    check("audio and WAV", wav_roundtrip)
    check("localflow", cleanup_module)
    check("Handy", handy)
    check("focused app and project", target)
    check("reading the focused text box", text_box)
    check("clipboard", clipboard)
    check("hotkey", hotkey)
    check("microphone", microphone)
    check("HTTPS", https)
    check("overlay", overlay_test)
    print(f"\n{results.count(False)} failed")
    return 1 if False in results else 0


class SkipTest(Exception):
    pass


def _catch(fn, events, errors):
    try:
        fn(events, lambda: False)
    except Exception as e:
        errors.append(str(e))


def main():
    args = sys.argv[1:]
    cmd, rest = (args[0] if args else ""), args[1:]
    raw = "raw" in rest
    if cmd == "start":
        cmd_start(raw)
    elif cmd == "stop":
        cmd_signal("stop")
    elif cmd == "cancel":
        cmd_signal("cancel")
    elif cmd == "toggle":
        cmd_signal("stop") if session_pid() else cmd_start(raw)
    elif cmd == "learn":
        cmd_learn()
    elif cmd == "_watch":
        cmd_watch(*rest[:2])
    elif cmd == "_session":
        cmd_session(raw)
    elif cmd == "--selftest":
        sys.exit(cmd_selftest(float(rest[0]) if rest else 3))
    elif cmd in ("-h", "--help"):
        print(__doc__.strip())
    elif cmd in ("", "--background") and SYSTEM in ("Windows", "Darwin"):
        cmd_background()
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
