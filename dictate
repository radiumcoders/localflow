class Paste:
    """Put text on the clipboard, press the paste keys, then restore the
    clipboard. Pasting instead of typing keeps list newlines from pressing Enter.
    Returns False when the keys couldn't be sent (the text stays on the clipboard)."""

    @staticmethod
    def text(text):
        if SYSTEM == "Windows":
            return Paste._windows(text)
        if SYSTEM == "Darwin":
            return Paste._mac(text)
        r = subprocess.run([str(HERE / "paste"), text])
        return r.returncode == 0

    @staticmethod
    def parts(parts):
        """Paste [(kind, value)] in order: "text", or "file" (a path) pasted as
        an attachment. The clipboard is restored once, at the end."""
        if SYSTEM == "Linux":
            args = []
            for kind, value in parts:
                args += [kind, Path(value).as_uri() if kind == "file" else value]
            return subprocess.run([str(HERE / "paste"), "--parts", *args]).returncode == 0
        mac = SYSTEM == "Darwin"
        if mac:
            env = dict(os.environ, LC_CTYPE="UTF-8")
            old = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout
            try:
                if not Quartz.lib().AXIsProcessTrusted():
                    return False
            except OSError:
                return False
        else:
            old = WinClipboard.get()
        for kind, value in parts:
            if kind == "file":
                Mac.copy_file(value) if mac else WinClipboard.set_files([value])
            elif mac:
                subprocess.run(["pbcopy"], input=value.encode(), env=env)
            else:
                WinClipboard.set(value.replace("\r\n", "\n").replace("\n", "\r\n"))
            time.sleep(0.05)
            Quartz.key(9, Quartz.CMD) if mac else WinKeys.press(0x56, ctrl=True)  # v
            time.sleep(0.3)  # let the app read the clipboard before it changes

        def restore():
            time.sleep(1)
            if mac:
                subprocess.run(["pbcopy"], input=old, env=env)
            elif old is not None:
                WinClipboard.set(old)
        threading.Thread(target=restore, daemon=True).start()
        return True

    @staticmethod
    def _mac(text):
        env = dict(os.environ, LC_CTYPE="UTF-8")
        old = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout
        subprocess.run(["pbcopy"], input=text.encode(), env=env)
        time.sleep(0.05)
        try:
            if not Quartz.lib().AXIsProcessTrusted():
                return False  # key presses would be dropped silently
            Quartz.key(9, Quartz.CMD)  # v
        except OSError:
            return False

        def restore():
            time.sleep(1)
            subprocess.run(["pbcopy"], input=old, env=env)
        threading.Thread(target=restore, daemon=True).start()
        return True

    @staticmethod
    def _windows(text):
        old = WinClipboard.get()
        WinClipboard.set(text.replace("\r\n", "\n").replace("\n", "\r\n"))
        time.sleep(0.05)
        u = ctypes.windll.user32
        for vk, up in ((0x11, 0), (0x56, 0), (0x56, 2), (0x11, 2)):  # Ctrl down, V down, V up, Ctrl up
            u.keybd_event(vk, 0, up, 0)

        def restore():
            time.sleep(1)
            if old is not None:
                WinClipboard.set(old)
        threading.Thread(target=restore, daemon=True).start()
        return True


class WinClipboard:
    CF_UNICODETEXT = 13

    @staticmethod
    def _open():
        u = ctypes.windll.user32
        for _ in range(20):
            if u.OpenClipboard(None):
                return True
            time.sleep(0.02)
        return False

    @classmethod
    def get(cls):
        u, k = ctypes.windll.user32, ctypes.windll.kernel32
        u.GetClipboardData.restype = ctypes.c_void_p
        k.GlobalLock.restype, k.GlobalLock.argtypes = ctypes.c_void_p, [ctypes.c_void_p]
        k.GlobalUnlock.argtypes = [ctypes.c_void_p]
        if not cls._open():
            return None
        try:
            h = u.GetClipboardData(cls.CF_UNICODETEXT)
            if not h:
                return None
            p = k.GlobalLock(h)
            try:
                return ctypes.wstring_at(p)
            finally:
                k.GlobalUnlock(h)
        finally:
            u.CloseClipboard()

    @classmethod
    def set(cls, text):
        return cls._set(cls.CF_UNICODETEXT, ctypes.create_unicode_buffer(text))

    @classmethod
    def set_files(cls, paths):
        """Files on the clipboard, as Explorer's Copy puts them (CF_HDROP)."""
        names = "".join(str(p) + "\0" for p in paths) + "\0"
        # DROPFILES: offset of the names, a point, fNC, fWide; then the names in UTF-16.
        header = (20).to_bytes(4, "little") + bytes(12) + (1).to_bytes(4, "little")
        data = header + names.encode("utf-16-le")
        return cls._set(15, ctypes.create_string_buffer(data, len(data)))  # CF_HDROP

    @classmethod
    def _set(cls, fmt, data):
        u, k = ctypes.windll.user32, ctypes.windll.kernel32
        k.GlobalAlloc.restype, k.GlobalAlloc.argtypes = ctypes.c_void_p, [ctypes.c_uint, ctypes.c_size_t]
        k.GlobalLock.restype, k.GlobalLock.argtypes = ctypes.c_void_p, [ctypes.c_void_p]
        k.GlobalUnlock.argtypes = [ctypes.c_void_p]
        u.SetClipboardData.argtypes = [ctypes.c_uint, ctypes.c_void_p]
        size = ctypes.sizeof(data)
        h = k.GlobalAlloc(0x0002, size)  # GMEM_MOVEABLE
        p = k.GlobalLock(h)
        ctypes.memmove(p, data, size)
        k.GlobalUnlock(h)
        if not cls._open():
            return False
        try:
            u.EmptyClipboard()
            return bool(u.SetClipboardData(fmt, h))
        finally:
            u.CloseClipboard()


class WinUIA:
    """The focused text box's text on Windows, through UI Automation (its COM
    interfaces, called through their vtables)."""
    _local = threading.local()

    class GUID(ctypes.Structure):
        _fields_ = [("a", ctypes.c_ulong), ("b", ctypes.c_ushort), ("c", ctypes.c_ushort), ("d", ctypes.c_ubyte * 8)]

    class VARIANT(ctypes.Structure):
        _fields_ = [("vt", ctypes.c_ushort), ("r1", ctypes.c_ushort), ("r2", ctypes.c_ushort),
                    ("r3", ctypes.c_ushort), ("value", ctypes.c_void_p), ("extra", ctypes.c_void_p)]

    @classmethod
    def get(cls):
        """One per thread (COM objects belong to the thread that made them)."""
        if not hasattr(cls._local, "uia"):
            cls._local.uia = cls()
        return cls._local.uia

    def __init__(self):
        ole = ctypes.WinDLL("ole32")
        ole.CoInitializeEx(None, 0)  # COINIT_MULTITHREADED; already initialized is fine
        self.ole, self.oleaut = ole, ctypes.WinDLL("oleaut32")
        self.oleaut.SysFreeString.argtypes = [ctypes.c_void_p]
        clsid, iid = self.guid("{ff48dba4-60ef-4201-aa87-54103eef594e}"), self.guid("{30cbe57d-d9d0-452a-ab13-7ac5ac4825ee}")
        self.uia = ctypes.c_void_p()
        hr = ole.CoCreateInstance(ctypes.byref(clsid), None, 1, ctypes.byref(iid), ctypes.byref(self.uia))
        if hr < 0 or not self.uia.value:
            raise OSError(f"UI Automation unavailable ({hr & 0xFFFFFFFF:#x})")

    def guid(self, text):
        g = self.GUID()
        self.ole.CLSIDFromString(ctypes.c_wchar_p(text), ctypes.byref(g))
        return g

    @staticmethod
    def call(obj, index, *args, argtypes=()):
        """Method `index` of a COM object's vtable. Returns the HRESULT."""
        vtable = ctypes.cast(obj, ctypes.POINTER(ctypes.POINTER(ctypes.c_void_p))).contents
        fn = ctypes.WINFUNCTYPE(ctypes.c_long, ctypes.c_void_p, *argtypes)(vtable[index])
        return fn(obj, *args)

    def release(self, obj):
        if obj and obj.value:
            self.call(obj, 2)

    def prop(self, element, prop_id):
        """A property of an element: an int or a str (None otherwise)."""
        var = self.VARIANT()
        if self.call(element, 10, prop_id, ctypes.byref(var), argtypes=(ctypes.c_int, ctypes.POINTER(self.VARIANT))) < 0:
            return None
        try:
            if var.vt == 3:  # VT_I4
                return ctypes.c_int.from_buffer_copy(ctypes.c_uint64(var.value or 0)).value
            if var.vt == 8:  # VT_BSTR
                return ctypes.wstring_at(var.value) if var.value else ""
            return None
        finally:
            self.oleaut.VariantClear(ctypes.byref(var))

    def document_text(self, element):
        """All the text of an element with the Text pattern (rich text boxes, browsers)."""
        pattern, doc, bstr = ctypes.c_void_p(), ctypes.c_void_p(), ctypes.c_void_p()
        iid = self.guid("{32eba289-3583-42c9-9c59-3b6d9a1e9b6a}")  # IUIAutomationTextPattern
        try:
            if self.call(element, 14, 10014, ctypes.byref(iid), ctypes.byref(pattern),  # GetCurrentPatternAs(Text)
                         argtypes=(ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p))) < 0 \
                    or not pattern.value:
                return None
            if self.call(pattern, 7, ctypes.byref(doc), argtypes=(ctypes.POINTER(ctypes.c_void_p),)) < 0 \
                    or not doc.value:  # DocumentRange
                return None
            if self.call(doc, 12, -1, ctypes.byref(bstr), argtypes=(ctypes.c_int, ctypes.POINTER(ctypes.c_void_p))) < 0:
                return None  # GetText(all)
            return ctypes.wstring_at(bstr.value) if bstr.value else ""
        finally:
            if bstr.value:
                self.oleaut.SysFreeString(bstr)
            self.release(doc)
            self.release(pattern)

    def focused_text(self):
        """(pid, text) of the focused element, if it holds text."""
        element = ctypes.c_void_p()
        if self.call(self.uia, 8, ctypes.byref(element), argtypes=(ctypes.POINTER(ctypes.c_void_p),)) < 0 \
                or not element.value:  # GetFocusedElement
            return None
        try:
            pid = self.prop(element, 30002)  # UIA_ProcessIdPropertyId
            text = self.prop(element, 30045)  # UIA_ValueValuePropertyId
            if not text:
                text = self.document_text(element)
            return (pid, text) if text else None
        finally:
            self.release(element)


class WinKeys:
    """Synthetic key presses on Windows."""

