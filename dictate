class Dictation:
    """Recording -> transcribe -> clean up -> paste. UI calls go through `ui`,
    a queue the Tk thread drains, so this works from any thread."""

    def __init__(self, ui, raw=False):
        self.ui, self.raw, self.busy = ui, raw, False
        self.recorder = Recorder(lambda chunk: ui.put(("level", level(chunk))))
        self.target, self.finder = None, None

    def start(self):
        self.recorder.start()
        self.ui.put(("recording", self.raw))
        if not self.raw:
            warm_cleanup_model()
            # While you speak: which app this goes to, and its project's files.
            self.finder = threading.Thread(target=self._find_target, daemon=True)
            self.finder.start()

    def _find_target(self):
        try:
            self.target = Target(*focused_window())
            log.info("dictating into %s", self.target)
        except Exception as e:
            log.info("couldn't tell where this goes: %s", e)

    def cancel(self):
        self.recorder.stop()
        self.ui.put(("hide",))
        log.info("cancelled")

    def finish(self):
        """Blocking: run it on a worker thread. Returns how long (ms) the
        closing message shows, 0 if none."""
        start = time.monotonic()
        pcm = self.recorder.stop()
        secs = len(pcm) / (2 * RATE)
        if secs < 0.3:
            self.ui.put(("message", "Too short"))
            return 1600
        try:
            self.ui.put(("working", "Transcribing"))
            text = transcribe(pcm)
            t_stt = time.monotonic() - start
            if not text:
                self.ui.put(("message", "Nothing heard"))
                log.info("%.1fs of audio, nothing heard", secs)
                return 1600
            files = []
            if not self.raw:
                self.ui.put(("working", "Cleaning up"))
                if self.finder:
                    self.finder.join(3)
                files = file_candidates(text, self.target.files) if self.target else []
                text = cleanup(text, files)
                if not text.strip():
                    self.ui.put(("message", "Left out an aside"))
                    log.info("%.1fs of audio, only an aside", secs)
                    return 1600
            self.ui.put(("hide",))
            time.sleep(0.1)
            pasted = deliver(text, self.target, files)
            stamp = remember(text)
            if pasted and not self.raw:
                start_watching(text, self.target, stamp, self.ui)
            log.info("%.1fs of audio: transcribed in %.2fs, done in %.2fs%s%s", secs, t_stt,
                     time.monotonic() - start, f" ({len(files)} files offered)" if files else "",
                     "" if pasted else " (left on the clipboard)")
            if not pasted:
                keys = "Cmd+V" if SYSTEM == "Darwin" else "Ctrl+V"
                self.ui.put(("message", f"Copied: paste with {keys}", 2500))
                return 2500
            return 0
        except Exception as e:
            log.exception("dictation failed")
            self.ui.put(("message", str(e)[:40] or "Something went wrong", 3000))
            return 3000


def make_ui():
    """(Tk root or None, overlay). Falls back to notifications without Tk."""
    try:
        import tkinter
        if SYSTEM == "Windows":
            try:
                ctypes.windll.shcore.SetProcessDpiAwareness(1)  # crisp, and real screen coordinates
            except (AttributeError, OSError):
                pass
        prev = Mac.frontmost_pid() if SYSTEM == "Darwin" else None
        root = tkinter.Tk(className="localflow-overlay")
        root.title("localflow")
        if SYSTEM == "Darwin":
            try:
                Mac.accessory()
            except Exception as e:
                log.info("couldn't hide the Dock icon: %s", e)
        overlay = Overlay(root)
        if SYSTEM == "Darwin":
            root.update()
            if prev and prev != os.getpid() and Mac.frontmost_pid() == os.getpid():
                Mac.activate(prev)  # Tk makes itself the active app on start
        return root, overlay
    except Exception as e:
        log.info("no overlay (%s), using notifications", e)
        return None, Headless()


class Mac:
    """The few AppKit calls dictate needs, through the Objective-C runtime."""
    _objc = None

    @classmethod
    def _rt(cls):
        if cls._objc is None:
            ctypes.cdll.LoadLibrary("/System/Library/Frameworks/AppKit.framework/AppKit")
            objc = ctypes.cdll.LoadLibrary(ctypes.util.find_library("objc"))
            objc.objc_getClass.restype, objc.objc_getClass.argtypes = ctypes.c_void_p, [ctypes.c_char_p]
            objc.sel_registerName.restype, objc.sel_registerName.argtypes = ctypes.c_void_p, [ctypes.c_char_p]
            cls._objc = objc
        return cls._objc

    @classmethod
    def send(cls, obj, sel, *args, argtypes=(), restype=ctypes.c_void_p):
        objc = cls._rt()
        fn = ctypes.CFUNCTYPE(restype, ctypes.c_void_p, ctypes.c_void_p, *argtypes)(("objc_msgSend", objc))
        return fn(obj, objc.sel_registerName(sel), *args)

    @classmethod
    def cls(cls, name):
        return cls._rt().objc_getClass(name)

    @classmethod
    def frontmost_pid(cls):
        try:
            ws = cls.send(cls.cls(b"NSWorkspace"), b"sharedWorkspace")
            app = cls.send(ws, b"frontmostApplication")
            return cls.send(app, b"processIdentifier", restype=ctypes.c_int) if app else None
        except Exception:
            return None

    @classmethod
    def activate(cls, pid):
        """Give focus back to another app."""
        app = cls.send(cls.cls(b"NSRunningApplication"), b"runningApplicationWithProcessIdentifier:", pid,
                       argtypes=(ctypes.c_int,))
        if app:
            cls.send(app, b"activateWithOptions:", 2, argtypes=(ctypes.c_ulong,), restype=ctypes.c_bool)

    @classmethod
    def click_through(cls):
        """Let clicks pass through this app's windows (the pill is never clicked)."""
        nsapp = cls.send(cls.cls(b"NSApplication"), b"sharedApplication")
        windows = cls.send(nsapp, b"windows")
        for i in range(cls.send(windows, b"count", restype=ctypes.c_ulong)):
            w = cls.send(windows, b"objectAtIndex:", i, argtypes=(ctypes.c_ulong,))
            cls.send(w, b"setIgnoresMouseEvents:", True, argtypes=(ctypes.c_bool,), restype=None)

    @classmethod
    def string(cls, text):
        return cls.send(cls.cls(b"NSString"), b"stringWithUTF8String:", text.encode(), argtypes=(ctypes.c_char_p,))

    @classmethod
    def text(cls, obj):
        """An NSString (or CFString) as a Python str."""
        raw = cls.send(obj, b"UTF8String", restype=ctypes.c_char_p) if obj else None
        return raw.decode("utf-8", "replace") if raw else ""

    @classmethod
    def focused(cls):
        """(bundle id, window title, pid, []) of the app you're typing in. The
        title needs the Accessibility permission; without it, it's empty."""
        ws = cls.send(cls.cls(b"NSWorkspace"), b"sharedWorkspace")
        app = cls.send(ws, b"frontmostApplication")
        if not app:
            return "", "", None, []
        pid = cls.send(app, b"processIdentifier", restype=ctypes.c_int)
        bundle = cls.text(cls.send(app, b"bundleIdentifier"))
        title = ""
        try:
            q, v = Quartz.lib(), ctypes.c_void_p
            q.AXUIElementCreateApplication.restype, q.AXUIElementCreateApplication.argtypes = v, [ctypes.c_int]
            q.AXUIElementCopyAttributeValue.restype = ctypes.c_int
            q.AXUIElementCopyAttributeValue.argtypes = [v, v, ctypes.POINTER(v)]
            element, window, value = q.AXUIElementCreateApplication(pid), v(), v()
            if element and not q.AXUIElementCopyAttributeValue(element, cls.string("AXFocusedWindow"),
                                                               ctypes.byref(window)) and window.value:
                if not q.AXUIElementCopyAttributeValue(window, cls.string("AXTitle"), ctypes.byref(value)) \
                        and value.value:
                    title = cls.text(value)
                    q.CFRelease(value)
                q.CFRelease(window)
            if element:
                q.CFRelease(element)
        except Exception as e:
            log.info("no window title: %s", e)
        return bundle, title, pid, []

    _manual = set()  # apps asked to turn on their accessibility tree

    @classmethod
    def focused_text(cls):
        """(pid, text) of the focused text box, through the Accessibility API."""
        q, v = Quartz.lib(), ctypes.c_void_p
        q.AXUIElementCreateSystemWide.restype = v
        q.AXUIElementCreateApplication.restype, q.AXUIElementCreateApplication.argtypes = v, [ctypes.c_int]
        q.AXUIElementCopyAttributeValue.restype = ctypes.c_int
        q.AXUIElementCopyAttributeValue.argtypes = [v, v, ctypes.POINTER(v)]
        q.AXUIElementSetAttributeValue.restype, q.AXUIElementSetAttributeValue.argtypes = ctypes.c_int, [v, v, v]
        q.AXUIElementGetPid.restype, q.AXUIElementGetPid.argtypes = ctypes.c_int, [v, ctypes.POINTER(ctypes.c_int)]
        q.CFGetTypeID.restype, q.CFGetTypeID.argtypes = ctypes.c_ulong, [v]
        q.CFStringGetTypeID.restype = ctypes.c_ulong
        system, element, value, pid = q.AXUIElementCreateSystemWide(), v(), v(), ctypes.c_int()
        try:
            if q.AXUIElementCopyAttributeValue(system, cls.string("AXFocusedUIElement"), ctypes.byref(element)) \
                    or not element.value:
                return None
            q.AXUIElementGetPid(element, ctypes.byref(pid))
            if pid.value not in cls._manual:
                # Electron apps (Cursor, Slack...) only fill in their tree when asked.
                cls._manual.add(pid.value)
                app = q.AXUIElementCreateApplication(pid.value)
                if app:
                    q.AXUIElementSetAttributeValue(app, cls.string("AXManualAccessibility"),
                                                   v.in_dll(q, "kCFBooleanTrue"))
                    q.CFRelease(app)
            if q.AXUIElementCopyAttributeValue(element, cls.string("AXValue"), ctypes.byref(value)) \
                    or not value.value:
                return None
            if q.CFGetTypeID(value) != q.CFStringGetTypeID():
                return None
            return pid.value, cls.text(value)
        finally:
            for ref in (value, element):
                if ref.value:
                    q.CFRelease(ref)
            if system:
                q.CFRelease(system)

    @classmethod
    def copy_file(cls, path):
        """A file on the clipboard, as Finder's Copy puts it."""
        url = cls.send(cls.cls(b"NSURL"), b"fileURLWithPath:", cls.string(path), argtypes=(ctypes.c_void_p,))
        items = cls.send(cls.cls(b"NSArray"), b"arrayWithObject:", url, argtypes=(ctypes.c_void_p,))
        pb = cls.send(cls.cls(b"NSPasteboard"), b"generalPasteboard")
        cls.send(pb, b"clearContents", restype=ctypes.c_long)
        return cls.send(pb, b"writeObjects:", items, argtypes=(ctypes.c_void_p,), restype=ctypes.c_bool)

    @classmethod
    def accessory(cls):
        """No Dock icon or menu bar: dictate is a background helper, not an app you switch to."""
        nsapp = cls.send(cls.cls(b"NSApplication"), b"sharedApplication")
        cls.send(nsapp, b"setActivationPolicy:", 1, argtypes=(ctypes.c_long,), restype=ctypes.c_bool)


def run_ui(root, overlay, ui, on_tick=None, period=30):
    """Drain UI requests on the Tk thread (or poll, without Tk)."""
    def drain():
        try:
            while True:
                op, *args = ui.get_nowait()
                if op == "level":
                    overlay.push_level(*args)
                elif op == "quit":
                    if root:
                        root.destroy()
                    return False
                else:
                    getattr(overlay, op)(*args)
        except queue.Empty:
            pass
        if on_tick and on_tick() is False:
            if root:
                root.destroy()
            return False
        return True

    if root:
        def loop():
            if drain():
                root.after(period, loop)
        loop()
        root.mainloop()
    else:
        while drain():
            time.sleep(period / 1000)


# --- Learning from your corrections ---------------------------------------------------
# The last pasted text is kept (readable only by you, in a temporary folder) so
# the learn key can compare your fixed version with it.

LAST = RUN / "last.json"


def remember(text):
    """Keep `text` as the last dictation. Returns its time stamp."""
    stamp = time.time()
    try:
        RUN.mkdir(parents=True, exist_ok=True)
        tmp = RUN / f"last-{os.getpid()}.tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
            json.dump({"text": text, "time": stamp}, f)
        os.replace(tmp, LAST)
    except OSError as e:
        log.info("couldn't keep the last dictation: %s", e)
    return stamp


def last_dictation():
    """(text, time stamp) of the last dictation, or (None, None)."""
    try:
        d = json.loads(LAST.read_text(encoding="utf-8"))
        return d["text"], d["time"]
    except (OSError, ValueError, KeyError, TypeError):
        return None, None


def learned_message(added):
    heard, meant = added[0]
    shown = f"Learned: {heard} → {meant}"
    return shown if len(added) == 1 and len(shown) <= 30 else f"Learned {len(added)} word{'s' * (len(added) > 1)}"


def selected_text():
    """Text you may have selected or copied, most likely first. Linux reads the
    selection directly; macOS and Windows copy it, then restore the clipboard."""
    def run(cmd):
        try:
            return subprocess.run(cmd, capture_output=True, timeout=2).stdout.decode("utf-8", "replace")
        except (OSError, subprocess.TimeoutExpired):
            return ""

    if SYSTEM == "Linux":
        if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
            return [run(["wl-paste", "--primary", "--no-newline"]), run(["wl-paste", "--no-newline"])]
        if shutil.which("xclip"):
            return [run(["xclip", "-o", "-selection", s]) for s in ("primary", "clipboard")]
        return [run(["xsel", "-o", flag]) for flag in ("-p", "-b")]
    for _ in range(100):  # wait for the learn key's modifiers to be let go, or the copy is Ctrl+Alt+C
        held = Quartz.modifiers_held() if SYSTEM == "Darwin" else any(
            ctypes.windll.user32.GetAsyncKeyState(vk) & 0x8000 for vk in (0x10, 0x11, 0x12, 0x5B, 0x5C))
        if not held:
            break
        time.sleep(0.02)
    if SYSTEM == "Darwin":
        env = dict(os.environ, LC_CTYPE="UTF-8")
        old = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout
        Quartz.key(8, Quartz.CMD)  # c
        time.sleep(0.25)
        new = subprocess.run(["pbpaste"], capture_output=True, env=env).stdout
        subprocess.run(["pbcopy"], input=old, env=env)
        return [new.decode("utf-8", "replace"), old.decode("utf-8", "replace")]
    old = WinClipboard.get()
    WinKeys.press(0x43, ctrl=True)  # c
    time.sleep(0.25)
    new = WinClipboard.get()
    if old is not None:
        WinClipboard.set(old)
    return [(t or "").replace("\r\n", "\n") for t in (new, old)]


def learn_correction():
    """Compare the text you fixed (selected or copied) with the last dictation
    and remember the words you changed. Returns a message to show."""
    last, _ = last_dictation()
    if last is None:
        return "Dictate something first"
    lf = localflow()
    for text in selected_text():
        pairs = lf.corrections(last, text) if text.strip() else None
        if pairs is not None:
            break
    else:
        return "Select the text you fixed"
    if not pairs:
        return "No changed words found"
    added = lf.learn(pairs)
    log.info("learned %d of %d corrections", len(added), len(pairs))  # not the words
    return learned_message(added) if added else "Already learned"


def cmd_learn():
    setup_logging()
    message = learn_correction()
    root, overlay = make_ui()
    ui = queue.Queue()
    ui.put(("message", message, 2500))
    started = time.monotonic()
    run_ui(root, overlay, ui, lambda: time.monotonic() - started < 2.7)


# --- Learning on its own -----------------------------------------------------------------
# For a few minutes after each paste, dictate looks for the version you kept:
# the message you sent to a coding agent or Cursor's chat (from their history
# files, on every OS), or, on macOS and Windows, the text box itself (through
# the accessibility API). The words you changed go to the cleanup model, which
# keeps the fixes of misheard words ("Claw" -> "Claude") and drops changes of
# mind ("Tuesday" -> "Wednesday"); those are learned. Nothing is logged.

WATCH_SECS = 180


def learning():
    """LOCALFLOW_LEARN: "auto" (default) learns your fixes on its own, "key"
    only when you press the learn key, "off" never."""
    localflow()  # reads the env file
    return os.environ.get("LOCALFLOW_LEARN", "auto").strip().lower()


def editor_state_db(name):
    base = {"Windows": Path(os.environ.get("APPDATA", HOME)), "Darwin": HOME / "Library/Application Support"
            }.get(SYSTEM, Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config"))
    return base / name / "User/globalStorage/state.vscdb"


class SentMessages:
    """Messages you send from now on: to Claude Code and Codex (their
    transcripts) and in Cursor's chat (its database)."""
    LOGS = (".claude/projects", ".codex/sessions")

    def __init__(self):
        self.started = time.time()
        self.offsets = {path: size for path, size in self._logs(self.started - 86400)}
        self.chats = {}
        for name in sorted(set(EDITORS.values())):
            db = editor_state_db(name)
            try:
                self.chats[db] = self._query(db, "SELECT max(rowid) FROM cursorDiskKV")[0][0] or 0
            except Exception:
                pass  # no such editor, or no chat history in it

    def _logs(self, since):
        for rel in self.LOGS:
            root = HOME / rel
            if root.is_dir():
                for path in root.rglob("*.jsonl"):
                    try:
                        st = path.stat()
                    except OSError:
                        continue
                    if st.st_mtime >= since:
                        yield path, st.st_size

    @staticmethod
    def _query(db, sql, *args):
        import sqlite3
        con = sqlite3.connect(f"{db.as_uri()}?mode=ro", uri=True, timeout=0.5)
        try:
            return con.execute(sql, args).fetchall()
        finally:
            con.close()

    @staticmethod
    def _user_text(entry):
        """Text you wrote, from one transcript line (Claude Code or Codex)."""
        if entry.get("type") == "user" and not entry.get("isMeta"):  # Claude Code
            content = (entry.get("message") or {}).get("content")
        elif (entry.get("payload") or {}).get("role") == "user":  # Codex
            content = entry["payload"].get("content")
        else:
            return []
        if isinstance(content, str):
            return [content]
        return [b.get("text", "") for b in content or () if isinstance(b, dict) and b.get("type") in ("text", "input_text")]

    def new(self):
        """What you sent since the last call."""
        texts = []
        for path, size in self._logs(self.started - 5):
            start = self.offsets.get(path, 0)
            if size <= start:
                continue
            try:
                with open(path, "rb") as f:
                    f.seek(start)
                    data = f.read(size - start)
            except OSError:
                continue
            done = data.rfind(b"\n") + 1  # a line still being written is read next time
            self.offsets[path] = start + done
            for line in data[:done].splitlines():
                try:
                    texts += self._user_text(json.loads(line))
                except (ValueError, AttributeError):
                    pass
        for db, rowid in self.chats.items():
            try:
                rows = self._query(db, "SELECT rowid, value FROM cursorDiskKV WHERE rowid > ? AND key LIKE 'bubbleId:%'",
                                   rowid)
            except Exception:
                continue
            for row, value in rows:
                self.chats[db] = max(self.chats[db], row)
                try:
                    bubble = json.loads(value)
                except (ValueError, TypeError):
                    continue
                if str(bubble.get("type")) == "1" and bubble.get("text"):  # 1: a message you wrote
                    texts.append(bubble["text"])
        return texts


def focused_text():
    """(pid, text) of the text box you're typing in, or None: macOS and Windows."""
    try:
        if SYSTEM == "Darwin":
            return Mac.focused_text()
        if SYSTEM == "Windows":
            return WinUIA.get().focused_text()
    except Exception as e:
        log.info("can't read the text box: %s", e)
    return None


def learn_on_its_own(pasted, edited, notify):
    lf = localflow()
    pairs = lf.corrections(pasted, edited)
    if not pairs:
        return
    try:
        keep = lf.mishearings(pasted, edited, pairs)
    except Exception as e:
        log.info("couldn't check the changes: %s", e)
        return
    added = lf.learn(keep)
    log.info("learned %d of %d changes you made", len(added), len(pairs))  # not the words
    if added:
        notify(learned_message(added))


def watch(pasted, pid, stamp, notify):
    """Learn the words you fix in what was just pasted (see above). Stops after
    WATCH_SECS, at the next dictation, or once it has seen what you kept."""
    lf, sent, kept = localflow(), SentMessages(), None
    deadline = time.monotonic() + WATCH_SECS
    while time.monotonic() < deadline:
        time.sleep(1.5)
        if last_dictation()[1] != stamp:
            break  # a newer dictation took over
        for text in sent.new():
            edited = lf.edited_region(pasted, text)
            if edited is not None:
                return learn_on_its_own(pasted, edited, notify)
        box = focused_text()
        if box and box[0] == pid:
            edited = lf.edited_region(pasted, box[1])
            if edited is not None:
                kept = edited  # still there, maybe being edited
                continue
        if kept is not None:  # sent, cleared, or you moved on: what was there is what you kept
            return learn_on_its_own(pasted, kept, notify)
    if kept is not None:
        learn_on_its_own(pasted, kept, notify)


def notify_desktop(text):
    """A desktop notification (Linux, where no overlay is running by then)."""
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "localflow", "-t", "4000", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start_watching(text, target, stamp, ui):
    """Watch for your fixes to `text` in the background: a thread in the
    macOS / Windows app, a short-lived process on Linux."""
    if learning() != "auto":
        return
    pid = getattr(target, "pid", None)
    if SYSTEM == "Linux":
        STATE.mkdir(parents=True, exist_ok=True)
        with open(STATE / "dictate.log", "a") as out:
            subprocess.Popen(ME + ["_watch", str(pid or 0), repr(stamp)],
                             stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True)
    else:
        threading.Thread(target=watch, args=(text, pid, stamp, lambda m: ui.put(("message", m, 3000))),
                         daemon=True).start()


def cmd_watch(pid, stamp):
