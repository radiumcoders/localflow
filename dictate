class PipeRecorder:
    """Raw 16 kHz mono s16 audio from a command's stdout (Linux, macOS)."""

    def __init__(self, on_chunk):
        self.on_chunk, self.chunks, self.proc = on_chunk, [], None

    @staticmethod
    def command():
        if shutil.which("pw-record"):
            return ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16", "-"]
        if shutil.which("parec"):
            return ["parec", "--rate", str(RATE), "--channels", "1", "--format", "s16le", "--raw"]
        if shutil.which("arecord"):
            return ["arecord", "-q", "-f", "S16_LE", "-r", str(RATE), "-c", "1", "-t", "raw"]
        if shutil.which("rec"):  # sox
            return ["rec", "-q", "-r", str(RATE), "-c", "1", "-b", "16", "-e", "signed-integer", "-t", "raw", "-"]
        if shutil.which("ffmpeg") and SYSTEM == "Darwin":
            return ["ffmpeg", "-loglevel", "quiet", "-f", "avfoundation", "-i", ":0",
                    "-ac", "1", "-ar", str(RATE), "-f", "s16le", "-"]
        raise RuntimeError("no recorder found: install pipewire (pw-record), alsa-utils or sox")

    def start(self):
        self.proc = subprocess.Popen(self.command(), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.reader = threading.Thread(target=self._read, daemon=True)
        self.reader.start()

    def _read(self):
        while True:
            data = self.proc.stdout.read1(1024) if hasattr(self.proc.stdout, "read1") else self.proc.stdout.read(1024)
            if not data:
                break
            self.chunks.append(data)
            self.on_chunk(data)

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.reader.join(1)  # it ends when the recorder's output closes
        pcm = b"".join(self.chunks)
        return pcm[:len(pcm) // 2 * 2]


class WinRecorder:
    """16 kHz mono s16 audio from the default microphone through winmm (Windows)."""

    class WAVEFORMATEX(ctypes.Structure):
        _fields_ = [("wFormatTag", ctypes.c_ushort), ("nChannels", ctypes.c_ushort),
                    ("nSamplesPerSec", ctypes.c_uint), ("nAvgBytesPerSec", ctypes.c_uint),
                    ("nBlockAlign", ctypes.c_ushort), ("wBitsPerSample", ctypes.c_ushort),
                    ("cbSize", ctypes.c_ushort)]

    class WAVEHDR(ctypes.Structure):
        _fields_ = [("lpData", ctypes.c_void_p), ("dwBufferLength", ctypes.c_uint),
                    ("dwBytesRecorded", ctypes.c_uint), ("dwUser", ctypes.c_size_t),
                    ("dwFlags", ctypes.c_uint), ("dwLoops", ctypes.c_uint),
                    ("lpNext", ctypes.c_void_p), ("reserved", ctypes.c_size_t)]

    WHDR_DONE = 1

    def __init__(self, on_chunk):
        self.on_chunk, self.chunks, self.running = on_chunk, [], False
        self.winmm = ctypes.WinDLL("winmm")

    def start(self):
        w = self.winmm
        fmt = self.WAVEFORMATEX(1, 1, RATE, RATE * 2, 2, 16, 0)
        self.handle = ctypes.c_void_p()
        rc = w.waveInOpen(ctypes.byref(self.handle), ctypes.c_uint(0xFFFFFFFF), ctypes.byref(fmt),
                          ctypes.c_size_t(0), ctypes.c_size_t(0), ctypes.c_uint(0))
        if rc:
            raise RuntimeError(f"couldn't open the microphone (waveInOpen error {rc})")
        size = RATE * 2 // 20  # 50 ms per buffer
        self.bufs = [ctypes.create_string_buffer(size) for _ in range(8)]
        self.hdrs = [self.WAVEHDR(ctypes.cast(b, ctypes.c_void_p), size, 0, 0, 0, 0, None, 0) for b in self.bufs]
        for h in self.hdrs:
            w.waveInPrepareHeader(self.handle, ctypes.byref(h), ctypes.sizeof(h))
            w.waveInAddBuffer(self.handle, ctypes.byref(h), ctypes.sizeof(h))
        w.waveInStart(self.handle)
        self.running = True
        self.thread = threading.Thread(target=self._poll, daemon=True)
        self.thread.start()

    def _take(self, h, requeue):
        if h.dwFlags & self.WHDR_DONE:
            data = ctypes.string_at(h.lpData, h.dwBytesRecorded)
            if data:
                self.chunks.append(data)
                self.on_chunk(data)
            h.dwFlags &= ~self.WHDR_DONE
            h.dwBytesRecorded = 0
            if requeue:
                self.winmm.waveInAddBuffer(self.handle, ctypes.byref(h), ctypes.sizeof(h))
            return True
        return False

    def _poll(self):
        i = 0
        while self.running:
            if self._take(self.hdrs[i], True):
                i = (i + 1) % len(self.hdrs)
            else:
                time.sleep(0.01)
        self.next = i

    def stop(self):
        w = self.winmm
        self.running = False
        self.thread.join()
        w.waveInStop(self.handle)
        w.waveInReset(self.handle)  # marks the buffer being filled as done
        for k in range(len(self.hdrs)):
            self._take(self.hdrs[(self.next + k) % len(self.hdrs)], False)
        for h in self.hdrs:
            w.waveInUnprepareHeader(self.handle, ctypes.byref(h), ctypes.sizeof(h))
        w.waveInClose(self.handle)
        return b"".join(self.chunks)


class MacRecorder:
    """16 kHz mono s16 audio from the default microphone through AudioToolbox's
    AudioQueue (macOS), so the app needs no sox. macOS asks to allow the
    microphone the first time."""

    class ASBD(ctypes.Structure):  # AudioStreamBasicDescription
        _fields_ = [("mSampleRate", ctypes.c_double), ("mFormatID", ctypes.c_uint32),
                    ("mFormatFlags", ctypes.c_uint32), ("mBytesPerPacket", ctypes.c_uint32),
                    ("mFramesPerPacket", ctypes.c_uint32), ("mBytesPerFrame", ctypes.c_uint32),
                    ("mChannelsPerFrame", ctypes.c_uint32), ("mBitsPerChannel", ctypes.c_uint32),
                    ("mReserved", ctypes.c_uint32)]

    class Buffer(ctypes.Structure):  # AudioQueueBuffer
        _fields_ = [("mAudioDataBytesCapacity", ctypes.c_uint32), ("mAudioData", ctypes.c_void_p),
                    ("mAudioDataByteSize", ctypes.c_uint32), ("mUserData", ctypes.c_void_p),
                    ("mPacketDescriptionCapacity", ctypes.c_uint32), ("mPacketDescriptions", ctypes.c_void_p),
                    ("mPacketDescriptionCount", ctypes.c_uint32)]

    # AudioQueueInputCallback(user data, queue, buffer, start time, packet count, packet descriptions)
    CALLBACK = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(Buffer),
                                ctypes.c_void_p, ctypes.c_uint32, ctypes.c_void_p)

    def __init__(self, on_chunk):
        self.on_chunk, self.chunks, self.stopping = on_chunk, [], False
        at = self.at = ctypes.cdll.LoadLibrary("/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox")
        v, buf = ctypes.c_void_p, ctypes.POINTER(self.Buffer)
        for name, args in [("AudioQueueNewInput", [ctypes.POINTER(self.ASBD), self.CALLBACK, v, v, v, ctypes.c_uint32,
                                                   ctypes.POINTER(v)]),
                           ("AudioQueueAllocateBuffer", [v, ctypes.c_uint32, ctypes.POINTER(buf)]),
                           ("AudioQueueEnqueueBuffer", [v, buf, ctypes.c_uint32, v]),
                           ("AudioQueueStart", [v, v]),
                           ("AudioQueueStop", [v, ctypes.c_ubyte]),
                           ("AudioQueueDispose", [v, ctypes.c_ubyte])]:
            fn = getattr(at, name)
            fn.argtypes, fn.restype = args, ctypes.c_int32  # OSStatus

    def _check(self, rc):
        if rc:
            raise RuntimeError(f"couldn't open the microphone (AudioQueue error {rc})")

    def start(self):
        at = self.at
        # Linear PCM, signed integer | packed
        fmt = self.ASBD(RATE, 0x6C70636D, 0x4 | 0x8, 2, 1, 2, 1, 16, 0)
        self.callback = self.CALLBACK(self._filled)  # kept alive while the queue runs
        self.queue = ctypes.c_void_p()
        self._check(at.AudioQueueNewInput(ctypes.byref(fmt), self.callback, None, None, None, 0,
                                          ctypes.byref(self.queue)))
        for _ in range(4):
            buf = ctypes.POINTER(self.Buffer)()
            self._check(at.AudioQueueAllocateBuffer(self.queue, RATE * 2 // 20, ctypes.byref(buf)))  # 50 ms
            at.AudioQueueEnqueueBuffer(self.queue, buf, 0, None)
        rc = at.AudioQueueStart(self.queue, None)
        if rc:
            at.AudioQueueDispose(self.queue, 1)
            self._check(rc)

    def _filled(self, _user, queue, buf, _time, _packets, _descs):
        b = buf.contents
        data = ctypes.string_at(b.mAudioData, b.mAudioDataByteSize) if b.mAudioDataByteSize else b""
        if data:
            self.chunks.append(data)
            self.on_chunk(data)
        if not self.stopping:
            self.at.AudioQueueEnqueueBuffer(queue, buf, 0, None)

    def stop(self):
        self.stopping = True
        self.at.AudioQueueStop(self.queue, 1)
        self.at.AudioQueueDispose(self.queue, 1)
        pcm = b"".join(self.chunks)
        return pcm[:len(pcm) // 2 * 2]


def Recorder(on_chunk):
    if SYSTEM == "Windows":
        return WinRecorder(on_chunk)
    if SYSTEM == "Darwin" and (FROZEN or not shutil.which("rec") and not shutil.which("ffmpeg")):
        return MacRecorder(on_chunk)  # the app, or no sox: macOS's own audio API
    return PipeRecorder(on_chunk)


def level(chunk):
    """Loudness of a chunk, 0..1 (RMS on a log scale, speech lands around 0.5-0.9)."""
    a = array.array("h", chunk[:len(chunk) // 2 * 2])
    if not a:
        return 0.0
    rms = math.sqrt(sum(x * x for x in a) / len(a))
    return max(0.0, min(1.0, (20 * math.log10(max(rms, 1)) - 25) / 45))


