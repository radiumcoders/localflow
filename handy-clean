WORDS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "words.txt")


def vocabulary():
    try:
        with open(WORDS) as f:
            return [w.strip() for w in f if w.strip() and not w.startswith("#")]
    except OSError:
        return []


def clean(text, model=MODEL):
    """Return the cleaned transcript, or the original if anything looks off."""
    text = text.strip()
    if not text:
        return text
    system = SYSTEM
    if words := vocabulary():
        system += "\n\nSpeaker's vocabulary (use these exact spellings):\n" + "\n".join(f"- {w}" for w in words)
    messages = [{"role": "system", "content": system}]
    for raw, cleaned in EXAMPLES:
        messages += [{"role": "user", "content": f"<dictation>{raw}</dictation>"},
                     {"role": "assistant", "content": cleaned}]
    messages.append({"role": "user", "content": f"<dictation>{text}</dictation>"})
    body = {
        "model": model,
        "messages": messages,
        "stream": False,
        "think": False,
        "keep_alive": KEEP_ALIVE,
        "options": {"temperature": 0, "num_predict": len(text) // 2 + 64},
    }
    req = urllib.request.Request(f"{OLLAMA}/api/chat", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        out = json.load(resp)["message"]["content"]
    out = re.sub(r"</?dictation>", "", out).strip()
    # Cleanup never adds much. A much longer reply means the model answered
    # or chatted instead of cleaning, so keep what the speaker said.
    if not out or len(out) > len(text) * 1.5 + 40:
        return text
    return out


class Handler(BaseHTTPRequestHandler):
    """Just enough of the OpenAI API for Handy: GET /v1/models, POST /v1/chat/completions."""

    def _json(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.rstrip("/") == "/v1/models":
            self._json(200, {"object": "list", "data": [{"id": "handy-clean", "object": "model"}]})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self):
        if self.path.rstrip("/") != "/v1/chat/completions":
            return self._json(404, {"error": "not found"})
        req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
        prompt = next((m["content"] for m in reversed(req.get("messages", []))
                       if m.get("role") == "user"), "")
        # Handy's prompt is "<dictation>${output}</dictation>"; take what's inside.
        m = re.search(r"<dictation>(.*)</dictation>", prompt, re.S)
        transcript = m.group(1) if m else prompt
        start = time.monotonic()
        try:
            out = clean(transcript)
        except Exception as e:  # Ollama down or slow: never lose the dictation
            print(f"ollama error: {e}", file=sys.stderr)
            out = transcript.strip()
        print(f"{round((time.monotonic() - start) * 1000)}ms", file=sys.stderr)
        self._json(200, {
            "id": "handy-clean", "object": "chat.completion", "model": "handy-clean",
            "choices": [{"index": 0, "finish_reason": "stop",
                         "message": {"role": "assistant", "content": out}}],
        })

    def log_message(self, *args):  # keep dictated text out of the journal
        pass


def serve():
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"handy-clean: http://127.0.0.1:{PORT}/v1 -> {OLLAMA} ({MODEL})", file=sys.stderr)
    server.serve_forever()


def check(out, spec):
    """Property checks for open-ended cases: "+text" must appear, "-text" must
    not, "order: a < b < c" must appear in that order (case-insensitive)."""
    low = out.lower()
    for part in (p.strip() for p in spec.split(";")):
        if part.startswith("+") and part[1:].strip().lower() not in low:
            return False
        if part.startswith("-") and part[1:].strip().lower() in low:
            return False
        if part.startswith("order:"):
            pos = [low.find(w.strip().lower()) for w in part[6:].split("<")]
            if -1 in pos or pos != sorted(pos):
                return False
    return True


def run_eval(model):
    cases_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cases.txt")
    cases = []
    with open(cases_path) as f:
        for line in f:
            if line.strip() and not line.startswith("#") and "=>" in line:
                raw, expected = (s.strip() for s in line.split("=>", 1))
                cases.append((raw, expected.replace("\\n", "\n")))

    digits = dict(zip("zero one two three four five six seven eight nine ten".split(), map(str, range(11))))
    norm = lambda s: [digits.get(w, w) for w in re.sub(r"[^\w\s]", "", s.lower()).split()]
    clean("warm up", model)  # load the model so the first case isn't timed cold
    passed, total_ms = 0, 0
    print(f"model: {model}\n")
    for raw, expected in cases:
        start = time.monotonic()
        out = clean(raw, model)
        ms = round((time.monotonic() - start) * 1000)
        total_ms += ms
        # Ignore punctuation/case differences, but list cases must match line by line.
        items = lambda t: [norm(l) for l in t.splitlines() if re.match(r"\s*\d+\.", l)]
        if expected.startswith("?"):
            ok = check(out, expected[1:])
        elif items(expected):
            # List cases: the numbered items must match; the lead-in may be reworded.
            ok = items(out) == items(expected)
        else:
            ok = norm(out) == norm(expected) and len(out.strip().splitlines()) == 1
        passed += ok
        print(f"{'PASS' if ok else 'FAIL'} {ms:5d}ms  {raw}")
        if not ok:
            show = lambda t: t.replace("\n", " | ")
            print(f"           want: {show(expected)}\n           got:  {show(out)}")
    print(f"\n{passed}/{len(cases)} passed, avg {total_ms // max(len(cases), 1)}ms")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:1] == ["serve"]:
        serve()
    elif args[:1] == ["--eval"]:
        run_eval(args[1] if len(args) > 1 else MODEL)
    elif args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
    else:
        sys.stdout.write(clean(sys.stdin.read()))
