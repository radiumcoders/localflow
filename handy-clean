WORDS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "words.txt")


def vocabulary():
    try:
        with open(WORDS) as f:
            return [w.strip() for w in f if w.strip() and not w.startswith("#")]
    except OSError:
        return []


REVIEW_SYSTEM = """You fix specific problems in a cleaned-up dictation. You get the cleanup RULES, the RAW speech-to-text transcript, the DRAFT cleanup, and PROBLEMS found by automatic checks.

Fix exactly those problems and change nothing else in the DRAFT: keep its wording, corrections, lists and formatting. If a problem turns out to be a false alarm, leave that part as it is. Answer {"text": "<the complete corrected text>"}."""

REVIEW_FORMAT = {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"]}

# Only checks that caught real mistakes in the eval are kept; checks for
# leftover correction phrases, spoken commands and similar-sounding words
# found nothing real (or only false alarms) and were removed.
QUALIFIERS = ["maybe", "only", "never", "except", "unless"]


def ollama_chat(model, messages, num_predict, fmt=None):
    body = {
        "model": model,
        "messages": messages,
        "stream": False,
        "think": False,
        "keep_alive": KEEP_ALIVE,
        "options": {"temperature": 0, "num_predict": num_predict},
    }
    if fmt:
        body["format"] = fmt
    req = urllib.request.Request(f"{OLLAMA}/api/chat", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)["message"]["content"]


def rules():
    system = SYSTEM
    if words := vocabulary():
        system += "\n\nSpeaker's vocabulary (use these exact spellings):\n" + "\n".join(f"- {w}" for w in words)
    return system


def plausible(out, text):
    # Cleanup never adds much. A much longer reply means the model answered
    # or chatted instead of cleaning.
    return bool(out) and len(out) <= len(text) * 1.5 + 40


def draft(text, model, system):
    """Checkpoint 1: few-shot cleanup and formatting."""
    messages = [{"role": "system", "content": system}]
    for raw, cleaned in EXAMPLES:
        messages += [{"role": "user", "content": f"<dictation>{raw}</dictation>"},
                     {"role": "assistant", "content": cleaned}]
    messages.append({"role": "user", "content": f"<dictation>{text}</dictation>"})
    out = ollama_chat(model, messages, len(text) // 2 + 64)
    return re.sub(r"</?dictation>", "", out).strip()


def words_in(t):
    return re.findall(r"[a-z']+", t.lower())


def has_phrase(t, phrase):
    return re.search(rf"\b{re.escape(phrase)}\b", t, re.I) is not None


def misheard_hints():
    """(term, [ways it gets misheard]) from words.txt lines like
    'Pine Script: TradingView's language, often heard as "Py script"'."""
    hints = []
    for w in vocabulary():
        term, _, hint = w.partition(":")
        if "heard as" in hint:
            hints.append((term.strip(), re.findall(r'"([^"]+)"', hint.split("heard as", 1)[1])))
    return hints


def find_problems(text, out):
    """Concrete, checkable mistakes in the draft. Each is phrased as an
    instruction for the repair pass."""
    problems = []
    raw_words, out_words = set(words_in(text)), set(words_in(out))
    for q in QUALIFIERS:
        if q in raw_words and q not in out_words:
            problems.append(f'The speaker said "{q}" but it was dropped. Put it back where it belongs, '
                            "unless it was part of a correction the speaker took back.")
    # A retraction left in place: "... pretty good, actually this is not pretty good, this is awesome".
    low = out.lower()
    for m in re.finditer(r"\b(?:actually|wait|no|sorry)\b[^.!?\n]{0,25}?\bnot ((?:[a-z']+ ?){1,4}?)\b[,.]", low):
        said = m.group(1).strip()
        if said and low.find(said) < m.start():
            problems.append(f'The speaker took back "{said}" ("{m.group(0).strip(" ,.")}"). Remove the retracted '
                            "version and the retraction itself, keeping only what they said instead.")
    for term, heard in misheard_hints():
        for h in heard:
            # Flag when the misheard form survived, or the right term never appeared.
            if has_phrase(text, h) and (has_phrase(out, h) or term.lower() not in out.lower()):
                problems.append(f'The speaker\'s "{h}" means "{term}". Use that exact spelling.')
    return problems


def review(text, first, model, system):
    """Checkpoint 2: automatic checks, then a fresh call (only the rules, raw
    text, draft and problem list) that repairs what the checks found.
    Returns (verdict, text): ("ok", None) or ("fix", repaired text)."""
    problems = find_problems(text, first)
    if not problems or model == "off":
        return ("ok" if not problems else f"{len(problems)} problems, repair off"), None
    listed = "\n".join(f"- {p}" for p in problems)
    prompt = f"RULES:\n{system}\n\nRAW:\n{text}\n\nDRAFT:\n{first}\n\nPROBLEMS:\n{listed}"
    out = ollama_chat(model, [{"role": "system", "content": REVIEW_SYSTEM},
                              {"role": "user", "content": prompt}],
                      len(text) // 2 + 128, fmt=REVIEW_FORMAT)
    try:
        fixed = (json.loads(out).get("text") or "").strip()
    except ValueError:
        return "invalid", None
    # Accept the repair only if it clears problems without adding new ones;
    # small models sometimes "fix" by dropping unrelated words.
    remaining = find_problems(text, fixed) if fixed else problems
    if fixed and fixed != first and len(remaining) < len(problems) and set(remaining) <= set(problems):
        return f"fix ({len(problems)}->{len(remaining)})", fixed
    return f"kept ({len(problems)})", None


def clean_detailed(text, model=MODEL, review_model=REVIEW_MODEL):
    """Run both checkpoints. Returns a dict with draft, final, verdict, timings."""
    text = text.strip()
    result = {"draft": text, "final": text, "verdict": "skipped", "ms_draft": 0, "ms_review": 0}
    if not text:
        return result
    system = rules()
    start = time.monotonic()
    first = draft(text, model, system)
    result["ms_draft"] = round((time.monotonic() - start) * 1000)
    if not plausible(first, text):
        return result  # keep what the speaker said
    result["draft"] = result["final"] = markdown_headings(first)
    start = time.monotonic()
    try:
        verdict, fixed = review(text, first, review_model, system)
    except Exception as e:  # the draft is already good enough to use
        verdict, fixed = f"error: {e}", None
    result["ms_review"] = round((time.monotonic() - start) * 1000)
    result["verdict"] = verdict
    if fixed and plausible(fixed, text):
        result["final"] = markdown_headings(fixed)
    elif fixed:
        result["verdict"] = "fix rejected"
    return result


def clean(text, model=MODEL, review_model=REVIEW_MODEL):
    """Return the cleaned transcript, or the original if anything looks off."""
    return clean_detailed(text, model, review_model)["final"]


SECTION_LEADIN = re.compile(r"(?:on|for|about|regarding) (?:the )?([\w'&/ -]{1,30}?)(?: side| front)?:", re.I)


def markdown_headings(out):
    """Small models often write section titles as bare lines ("Sales") or
    lead-ins ("On hiring:"). When there are two or more (on their own line,
    after a blank line, followed by text), make them "## " headings."""
    lines = out.split("\n")
    leadins = [i for i, line in enumerate(lines)
               if SECTION_LEADIN.fullmatch(line.strip()) and (i == 0 or not lines[i - 1].strip())
               and i + 1 < len(lines) and lines[i + 1].strip()]
    if len(leadins) >= 2:
        for i in leadins:
            title = SECTION_LEADIN.fullmatch(lines[i].strip()).group(1).strip()
            lines[i] = title[0].upper() + title[1:]
    titles = [i for i, line in enumerate(lines)
              if re.fullmatch(r"[A-Z][\w'&/ -]{0,40}", line.strip())
              and len(line.split()) <= 4
              and (i == 0 or not lines[i - 1].strip())
              and i + 1 < len(lines) and lines[i + 1].strip()]
    if len(titles) < 2:
        return out
    for i in titles:
        lines[i] = "## " + lines[i].strip()
    return "\n".join(lines)


class Handler(BaseHTTPRequestHandler):
    """Just enough of the OpenAI API for Handy: GET /v1/models, POST /v1/chat/completions."""

    def _json(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.rstrip("/") == "/v1/models":
            self._json(200, {"object": "list", "data": [{"id": "handy-clean", "object": "model"}]})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self):
        if self.path.rstrip("/") != "/v1/chat/completions":
            return self._json(404, {"error": "not found"})
        req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
        prompt = next((m["content"] for m in reversed(req.get("messages", []))
                       if m.get("role") == "user"), "")
        # Handy's prompt is "<dictation>${output}</dictation>"; take what's inside.
        m = re.search(r"<dictation>(.*)</dictation>", prompt, re.S)
        transcript = m.group(1) if m else prompt
        try:
            r = clean_detailed(transcript)
            out = r["final"]
            print(f"draft {r['ms_draft']}ms, review {r['ms_review']}ms: {r['verdict']}", file=sys.stderr)
        except Exception as e:  # Ollama down or slow: never lose the dictation
            print(f"ollama error: {e}", file=sys.stderr)
            out = transcript.strip()
        self._json(200, {
            "id": "handy-clean", "object": "chat.completion", "model": "handy-clean",
            "choices": [{"index": 0, "finish_reason": "stop",
                         "message": {"role": "assistant", "content": out}}],
        })

    def log_message(self, *args):  # keep dictated text out of the journal
        pass


def serve():
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"handy-clean: http://127.0.0.1:{PORT}/v1 -> {OLLAMA} ({MODEL})", file=sys.stderr)
    server.serve_forever()


def check(out, spec):
    """Property checks for open-ended cases: "+text" must appear, "-text" must
    not, "order: a < b < c" must appear in that order, "count: text >= n"
    must appear at least n times (all case-insensitive)."""
    low = out.lower()
    for part in (p.strip() for p in spec.split(";")):
        if part.startswith("+") and part[1:].strip().lower() not in low:
            return False
        if part.startswith("-") and part[1:].strip().lower() in low:
            return False
        if part.startswith("count:"):
            text, n = part[6:].rsplit(">=", 1)
            if low.count(text.strip().lower()) < int(n):
                return False
        if part.startswith("order:"):
            pos = [low.find(w.strip().lower()) for w in part[6:].split("<")]
            if -1 in pos or pos != sorted(pos):
                return False
    return True


def run_eval(model, review_model):
    cases_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cases.txt")
    cases = []
    with open(cases_path) as f:
        for line in f:
            if line.strip() and not line.startswith("#") and "=>" in line:
                raw, expected = (s.strip() for s in line.split("=>", 1))
                cases.append((raw, expected.replace("\\n", "\n")))

    digits = dict(zip("zero one two three four five six seven eight nine ten".split(), map(str, range(11))))
    norm = lambda s: [digits.get(w, w) for w in re.sub(r"[^\w\s]", "", s.lower()).split()]
    items = lambda t: [norm(l) for l in t.splitlines() if re.match(r"\s*\d+\.", l)]

    def grade(out, expected):
        if expected.startswith("?"):
            return check(out, expected[1:])
        if items(expected):
            # List cases: the numbered items must match; the lead-in may be reworded.
            return items(out) == items(expected)
        # Ignore punctuation/case differences; must stay a single line.
        return norm(out) == norm(expected) and len(out.strip().splitlines()) == 1

    clean("warm up", model, review_model)  # load the models so the first case isn't timed cold
    drafts_ok = finals_ok = fixed = broke = changed = 0
    ms_draft = ms_review = 0
    print(f"model: {model}, review: {review_model}\n")
    for raw, expected in cases:
        r = clean_detailed(raw, model, review_model)
        d_ok, f_ok = grade(r["draft"], expected), grade(r["final"], expected)
        drafts_ok += d_ok
        finals_ok += f_ok
        changed += r["final"] != r["draft"]
        fixed += f_ok and not d_ok
        broke += d_ok and not f_ok
        ms_draft += r["ms_draft"]
        ms_review += r["ms_review"]
        tag = "PASS" if f_ok else "FAIL"
        if d_ok != f_ok:
            tag += " (review fixed)" if f_ok else " (review broke)"
        print(f"{tag} {r['ms_draft']:5d}+{r['ms_review']:<5d}ms [{r['verdict']}]  {raw[:110]}")
        if not f_ok or d_ok != f_ok:
            show = lambda t: t.replace("\n", " | ")
            print(f"           want:  {show(expected)[:300]}")
            if d_ok != f_ok:
                print(f"           draft: {show(r['draft'])[:300]}")
            print(f"           final: {show(r['final'])[:300]}")
    n = max(len(cases), 1)
    print(f"\ndraft {drafts_ok}/{len(cases)}, final {finals_ok}/{len(cases)} "
          f"(review changed {changed}: fixed {fixed}, broke {broke}); "
          f"avg {ms_draft // n}ms draft + {ms_review // n}ms review")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:1] == ["serve"]:
        serve()
    elif args[:1] == ["--eval"]:
        run_eval(args[1] if len(args) > 1 else MODEL, args[2] if len(args) > 2 else REVIEW_MODEL)
    elif args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
    else:
        sys.stdout.write(clean(sys.stdin.read()))
