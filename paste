#!/usr/bin/env bash
# paste "<text>": paste text into the focused window (Linux). Used by `dictate`
# and by Handy's "external script" paste method.
# paste --parts KIND VALUE [KIND VALUE ...]: several pieces in order (dictate's
# file references). KIND is text (pasted) or file (a file:// URI, pasted as
# the file itself, an attachment).
#
# Pastes instead of typing, so list newlines don't press Enter. The previous
# clipboard is restored a moment later, once the app has had time to read the
# new one. If the paste keys can't be sent, the text stays on the clipboard
# and this exits 1.
#   Wayland: wl-copy + wtype. On Hyprland, Shift+Insert in terminals (like
#            Omarchy's universal paste) and VS Code-family editors (their
#            webview panels, like Claude Code's, ignore a synthetic Ctrl+V),
#            Ctrl+V elsewhere.
#   X11:     xclip (or xsel) + xdotool. Ctrl+Shift+V in terminals.
set -u
if [[ ${1:-} == --parts ]]; then
  shift
  parts=("$@")
else
  parts=(text "$1")
fi
old=$(mktemp)
EDITORS='^(cursor|code|code-oss|codium|vscodium|windsurf)$'

restore_later() {
  (
    sleep 1
    "$@" <"$old"
    rm -f "$old"
  ) >/dev/null 2>&1 &
  disown
}

fail() {
  rm -f "$old"
  exit 1
}

if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null; then
  old_type=$(wl-paste --list-types 2>/dev/null | head -n1)
  [[ -n $old_type ]] && wl-paste --no-newline --type "$old_type" >"$old" 2>/dev/null
  keys=(-M ctrl -k v -m ctrl)
  if command -v hyprctl >/dev/null; then
    window=$(hyprctl activewindow -j 2>/dev/null)
    class=$(sed -n 's/^ *"class": "\(.*\)",$/\1/p' <<<"$window" | head -n1)
    # Same terminal test Omarchy uses: the window carries the "terminal" tag (dynamic tags end in *).
    if grep -qE '"tags": \[[^]]*"terminal\*?"' <<<"$window" || [[ ${class,,} =~ $EDITORS ]]; then
      keys=(-M shift -k Insert -m shift)
    fi
  fi
  for ((i = 0; i + 1 < ${#parts[@]}; i += 2)); do
    kind=${parts[i]} value=${parts[i + 1]}
    case $kind in
    file) printf '%s\r\n' "$value" | wl-copy --type text/uri-list ;;
    *) printf '%s' "$value" | wl-copy ;;
    esac
    sleep 0.05
    wtype "${keys[@]}" 2>/dev/null || fail
    ((i + 2 < ${#parts[@]})) && sleep 0.3 # let the app read the clipboard before it changes
  done
  if [[ -n $old_type ]]; then restore_later wl-copy --type "$old_type"; else rm -f "$old"; fi

elif [[ -n ${DISPLAY:-} ]]; then
  if command -v xclip >/dev/null; then
    copy=(xclip -selection clipboard -in) get=(xclip -selection clipboard -out)
    copy_file=(xclip -selection clipboard -t text/uri-list -in)
  elif command -v xsel >/dev/null; then
    copy=(xsel --clipboard --input) get=(xsel --clipboard --output)
    copy_file=() # xsel can't label the type: file references go in as text
  else
    fail
  fi
  "${get[@]}" >"$old" 2>/dev/null
  class=$(xdotool getactivewindow getwindowclassname 2>/dev/null)
  if [[ ${class,,} =~ term|kitty|alacritty|ghostty|konsole|tilix|wezterm|foot|terminator ]]; then
    key=ctrl+shift+v
  elif [[ ${class,,} =~ $EDITORS ]]; then
    key=shift+Insert
  else
    key=ctrl+v
  fi
  for ((i = 0; i + 1 < ${#parts[@]}; i += 2)); do
    kind=${parts[i]} value=${parts[i + 1]}
    case $kind in
    file)
      if ((${#copy_file[@]})); then
        printf '%s\r\n' "$value" | "${copy_file[@]}"
      else
        printf '%s' "$value" | "${copy[@]}"
      fi
      ;;
    *) printf '%s' "$value" | "${copy[@]}" ;;
    esac
    sleep 0.05
    xdotool key --clearmodifiers "$key" 2>/dev/null || fail
    ((i + 2 < ${#parts[@]})) && sleep 0.3
  done
  if [[ -s $old ]]; then restore_later "${copy[@]}"; else rm -f "$old"; fi

else
  fail
fi
